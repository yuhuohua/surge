#!name=中国移动
#!desc=在「中国移动」App 登录一次捕获参数。
#!icon=https://raw.githubusercontent.com/yuhuohua/tupiao/refs/heads/main/zgyd.png
#!category=本地调试
#!arguments=刷新Cron:"*/15 * * * *",抓取开关:"",存储前缀:"cm1",面板标题:"中国移动",面板刷新间隔:"1800",手机号:""

[Script]
{{{抓取开关}}}中国移动登录捕获1 = type=http-request, pattern=^https?:\/\/(client\.app\.coc\.10086\.cn|10086\.online-cmcc\.cn)(:\d+)?\/, script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/zgyd.js, requires-body=true, timeout=15, argument=prefix={{{存储前缀}}}&title={{{面板标题}}}&phone={{{手机号}}}

{{{抓取开关}}}中国移动Cookie捕获1 = type=http-response, pattern=^https?:\/\/(client\.app\.coc\.10086\.cn|10086\.online-cmcc\.cn)(:\d+)?\/, script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/zgyd.js, requires-body=false, timeout=15, argument=prefix={{{存储前缀}}}

中国移动保活1 = type=cron, cronexp="{{{刷新Cron}}}", script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/zgyd.js, wake-system=1, timeout=60, argument=action=task&prefix={{{存储前缀}}}&title={{{面板标题}}}&phone={{{手机号}}}

中国移动面板1 = type=generic, script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/zgyd.js, timeout=30, argument=action=panel&prefix={{{存储前缀}}}&title={{{面板标题}}}&phone={{{手机号}}}

[Panel]
中国移动面板1 = script-name=中国移动面板1, title="移动卡1", content="正在拉取数据...", style=info, update-interval={{{面板刷新间隔}}}

[MITM]
hostname = %APPEND% client.app.coc.10086.cn, 10086.online-cmcc.cn, *.10086.cn
