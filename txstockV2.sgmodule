#!name=腾讯自选股
#!desc=腾讯自选股自动任务提现
#!arguments=CRON定时设置:"35 11,16 * * *"
#!arguments-desc=CRON定时设置: 签到脚本的 CRON 表达式(默认11点35分和16点35分运行)

[Script]
# 抓 CK：APP + 公众号小程序
腾讯自选股抓CK = type=http-request, pattern=^https:\/\/wzq\.tenpay\.com\/cgi-bin\/.*user.*\.fcgi, script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/txstockV2.js

# 定时任务
腾讯自选股定时 = type=cron, cronexp="{{{CRON定时设置}}}", script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/txstockV2.js, timeout=600

[MITM]
hostname = %APPEND% wzq.tenpay.com
