#!name=网络雷达
#!desc=网络信息面板
#!author=〈ザㄩメ火华
#!category=小组件
#!arguments-desc=[配置参数]\n\n⓵ 策略组: 指定测速、IP查询与解锁检测所走的策略组。留空则走 Surge 默认分流，填写策略组名称（如 DIRECT 或 🚀 节点选择）则强制走指定策略。
#!arguments=策略组:""

[Script]
网络雷达 = type=http-request, pattern=^http://netradar\.surge\.api, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/wlld.js, argument={{{策略组}}}

[MITM]
hostname = %APPEND% netradar.surge.api