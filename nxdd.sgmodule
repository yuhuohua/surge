#!name=奈雪点单每日签到
#!desc=奈雪点单微信小程序每日签到
#!category=本地调试
#!author=〈ザㄩメ火华
#!arguments=CRON定时设置:"30 12 * * *", 抓取开关:""
#!arguments-desc=CRON定时设置: 签到脚本的 CRON 表达式(默认12点30分运行); 抓取开关: 填写 # 即可禁用Token捕获

[Script]
{{{抓取开关}}}奈雪点单获取Token = type=http-request, pattern=^https:\/\/(tm-api|tm-web)\.pin-dao\.cn\/, requires-header=1, max-size=0, script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/nxdd.js

奈雪点单定时签到 = type=cron, cronexp="{{{CRON定时设置}}}", script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/nxdd.js

[MITM]
hostname = %APPEND% tm-web.pin-dao.cn, tm-api.pin-dao.cn