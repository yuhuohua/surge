#!name=😀 WPS 每日签到 + 福利中心多项任务
#!desc=使用步骤：1、按下方对应平台配置,开启重写脚本 + cron。2、打开「WPS」APP → 进任意活动页(任务中心 / 福利中心「天天领福利」)停留 1 秒。3、收到 ✅ WPS Cookie 获取成功 通知即抓取成功。4、cron 每天 10:00 触发
#!arguments=CRON定时设置:"0 9 * * *", Token获取开关:""
#!arguments-desc=CRON定时设置: 签到脚本的 CRON 表达式; Token获取开关: 填写 # 即可禁用Token捕获

[Script]
{{{Token获取开关}}}WPS Cookie = type=http-request,pattern=^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js

WPS签到 = type=cron, cronexp="{{{CRON定时设置}}}",timeout=120,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js

[MITM]
hostname = personal-act.wps.cn